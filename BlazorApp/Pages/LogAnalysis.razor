@page "/reports/log-analysis"

<PageTitle>@PageTitleText</PageTitle>

@* <div class="dense-page log-analysis-page"> *@
<TelerikDockManager Class="log-analysis-dock-manager" Width="100%" Height="98%">
    <DockManagerPanes>
        <DockManagerSplitPane Orientation="DockManagerPaneOrientation.Horizontal">
            <Panes>
                <DockManagerContentPane Size="15%" HeaderText="Criteria">
                    <Content>
                        <TelerikForm Model="@CriteriaInput" OnValidSubmit="@OnSubmitAsync">
                            <FormValidation>
                                <DataAnnotationsValidator />
                            </FormValidation>
                            <FormItems>
                                <FormItem>
                                    <Template>
                                        <div class="k-form k-form-sm">
                                            <div class="k-form-field k-mb-2">
                                                <label for="log-analysis-application">Application Summary</label>
                                                <ApplicationSummaryComboBox Data="@Applications"
                                                                            @bind-Value="CriteriaInput.SelectedApplicationSummary"
                                                                            Placeholder="Select application"
                                                                            Width="220px"
                                                                            AdditionalAttributes="@(new Dictionary<string, object> { ["id"] = "log-analysis-application" })" />
                                                <ValidationMessage For="@(() => CriteriaInput.SelectedApplicationSummary)" />
                                            </div>

                                            <div class="k-form-field k-mb-2">
                                                <label for="log-analysis-from-date">From</label>
                                                <TelerikDateTimePicker Id="log-analysis-from-date" @bind-Value="CriteriaInput.FromDate" Format="MM/dd/yyyy hh:mm" />
                                                <ValidationMessage For="@(() => CriteriaInput.FromDate)" />
                                            </div>

                                            <div class="k-form-field k-mb-2">
                                                <label for="log-analysis-to-date">To</label>
                                                <TelerikDateTimePicker Id="log-analysis-to-date" @bind-Value="CriteriaInput.ToDate" Format="MM/dd/yyyy hh:mm" />
                                                <ValidationMessage For="@(() => CriteriaInput.ToDate)" />
                                            </div>

                                            <div class="k-form-field k-mb-2">
                                                <label for="log-analysis-window-unit">Window Unit</label>
                                                <TelerikDropDownList Id="log-analysis-window-unit"
                                                                     TItem="WindowUnit"
                                                                     TValue="WindowUnit"
                                                                     Data="@WindowUnits"
                                                                     @bind-Value="CriteriaInput.WindowUnit" />
                                                <ValidationMessage For="@(() => CriteriaInput.WindowUnit)" />
                                            </div>

                                            <div class="k-form-field k-mb-2">
                                                <label for="log-analysis-window-size">Window Size</label>
                                                <div title="Number of log entries in each analysis window">
                                                    <TelerikNumericTextBox Id="log-analysis-window-size"
                                                                           @bind-Value="CriteriaInput.WindowSize"
                                                                           Min="1"
                                                                           Decimals="0"
                                                                           Format="n0" />
                                                </div>
                                                <ValidationMessage For="@(() => CriteriaInput.WindowSize)" />
                                            </div>
                                            
                                            <div class="k-form-field k-mb-2">
                                                <label for="log-analysis-action-count">Actions to Analyze</label>
                                                <TelerikNumericTextBox Id="log-analysis-action-count" @bind-Value="CriteriaInput.ActionCountToAnalyze" Min="1" Decimals="0" Format="n0" />
                                                <ValidationMessage For="@(() => CriteriaInput.ActionCountToAnalyze)" />
                                            </div>

                                        </div>
                                    </Template>
                                </FormItem>
                            </FormItems>
                        </TelerikForm>
                    </Content>
                </DockManagerContentPane>

                <DockManagerContentPane Size="85%" AllowFloat="true" Closeable="false" Unpinnable="true">
                    <Content>
                        <div class="log-analysis-right-panel-placeholder">
                            <TelerikTileLayout Class="log-analysis-tile-layout"
                                               Columns="5"
                                               ColumnWidth="1fr"
                                               RowHeight="auto"
                                               Width="100%"
                                               Height="100%">
                                <TileLayoutItems>
                                    <TileLayoutItem ColSpan="1" RowSpan="1">
                                        <HeaderTemplate>
                                            <div class="k-d-flex k-align-items-center k-justify-content-between k-gap-2">
                                                <span>Summary</span>
                                                <div @onclick:stopPropagation="true">
                                                    <TelerikButton Size="ComponentSize.Small"
                                                                   FillMode="ButtonFillMode.Flat"
                                                                   ThemeColor="ThemeConstants.Button.ThemeColor.Light"
                                                                   Icon="@SvgIcon.InfoCircle"
                                                                   Title="Show summary info"
                                                                   OnClick="@(() => ToggleTileInfo(LogAnalysisTileInfo.Summary))" />
                                                </div>
                                            </div>
                                            @if (ActiveTileInfo == LogAnalysisTileInfo.Summary)
                                            {
                                                <div class="k-text-xs k-mt-1">@GetTileInfoText(LogAnalysisTileInfo.Summary)</div>
                                            }
                                        </HeaderTemplate>
                                        <Content>
                                            <div class="log-analysis-tile-content">
                                                <div><strong>Log entries:</strong> @LogDataResults.Count</div>
                                                <div><strong>Actions analyzed:</strong> @LogDataTimeTakenResults.Count</div>
                                            </div>
                                        </Content>
                                    </TileLayoutItem>
                                    <TileLayoutItem ColSpan="2" RowSpan="1">
                                        <HeaderTemplate>
                                            <div class="k-d-flex k-align-items-center k-justify-content-between k-gap-2">
                                                <span>Rolling Window Trend</span>
                                                <div @onclick:stopPropagation="true">
                                                    <TelerikButton Size="ComponentSize.Small"
                                                                   FillMode="ButtonFillMode.Flat"
                                                                   ThemeColor="ThemeConstants.Button.ThemeColor.Light"
                                                                   Icon="@SvgIcon.InfoCircle"
                                                                   Title="Show rolling window trend info"
                                                                   OnClick="@(() => ToggleTileInfo(LogAnalysisTileInfo.RollingWindowTrend))" />
                                                </div>
                                            </div>
                                            @if (ActiveTileInfo == LogAnalysisTileInfo.RollingWindowTrend)
                                            {
                                                <div class="k-text-xs k-mt-1">@GetTileInfoText(LogAnalysisTileInfo.RollingWindowTrend)</div>
                                            }
                                        </HeaderTemplate>
                                        <Content>
                                            <RollingWindowTrendGrid Results="@RollingWindowTrendResults" />
                                        </Content>
                                    </TileLayoutItem>
                                    <TileLayoutItem ColSpan="2" RowSpan="1">
                                        <HeaderTemplate>
                                            <div class="k-d-flex k-align-items-center k-justify-content-between k-gap-2">
                                                <span>Trend Slope (Long-Term Drift)</span>
                                                <div @onclick:stopPropagation="true">
                                                    <TelerikButton Size="ComponentSize.Small"
                                                                   FillMode="ButtonFillMode.Flat"
                                                                   ThemeColor="ThemeConstants.Button.ThemeColor.Light"
                                                                   Icon="@SvgIcon.InfoCircle"
                                                                   Title="Show trend slope info"
                                                                   OnClick="@(() => ToggleTileInfo(LogAnalysisTileInfo.TrendSlope))" />
                                                </div>
                                            </div>
                                            @if (ActiveTileInfo == LogAnalysisTileInfo.TrendSlope)
                                            {
                                                <div class="k-text-xs k-mt-1">@GetTileInfoText(LogAnalysisTileInfo.TrendSlope)</div>
                                            }
                                        </HeaderTemplate>
                                        <Content>
                                            <TrendSlopeGrid Results="@TrendSlopeResults" />
                                        </Content>
                                    </TileLayoutItem>
                                    <TileLayoutItem ColSpan="5" RowSpan="2">
                                        <HeaderTemplate>
                                            <div class="k-d-flex k-align-items-center k-justify-content-between k-gap-2">
                                                <span>Windowed Latency Trend</span>
                                                <div @onclick:stopPropagation="true">
                                                    <TelerikButton Size="ComponentSize.Small"
                                                                   FillMode="ButtonFillMode.Flat"
                                                                   ThemeColor="ThemeConstants.Button.ThemeColor.Light"
                                                                   Icon="@SvgIcon.InfoCircle"
                                                                   Title="Show windowed latency trend info"
                                                                   OnClick="@(() => ToggleTileInfo(LogAnalysisTileInfo.WindowedLatencyTrend))" />
                                                </div>
                                            </div>
                                            @if (ActiveTileInfo == LogAnalysisTileInfo.WindowedLatencyTrend)
                                            {
                                                <div class="k-text-xs k-mt-1">@GetTileInfoText(LogAnalysisTileInfo.WindowedLatencyTrend)</div>
                                            }
                                        </HeaderTemplate>
                                        <Content>
                                            <ActionLatencyTrendWindowedChart Results="@WindowedTrendResults" />
                                        </Content>
                                    </TileLayoutItem>
                                    <TileLayoutItem ColSpan="5" RowSpan="2">
                                        <HeaderTemplate>
                                            <div class="k-d-flex k-align-items-center k-justify-content-between k-gap-2">
                                                <span>Action Response Time Moving Average</span>
                                                <div @onclick:stopPropagation="true">
                                                    <TelerikButton Size="ComponentSize.Small"
                                                                   FillMode="ButtonFillMode.Flat"
                                                                   ThemeColor="ThemeConstants.Button.ThemeColor.Light"
                                                                   Icon="@SvgIcon.InfoCircle"
                                                                   Title="Show moving average info"
                                                                   OnClick="@(() => ToggleTileInfo(LogAnalysisTileInfo.MovingAverageTrend))" />
                                                </div>
                                            </div>
                                            @if (ActiveTileInfo == LogAnalysisTileInfo.MovingAverageTrend)
                                            {
                                                <div class="k-text-xs k-mt-1">@GetTileInfoText(LogAnalysisTileInfo.MovingAverageTrend)</div>
                                            }
                                        </HeaderTemplate>
                                        <Content>
                                            <div class="log-analysis-tile-content">
                                                <ActionLatencyTrendMovingAverageChart Results="@MovingAverageTrendResults" />
                                            </div>
                                        </Content>
                                    </TileLayoutItem>

                                    <TileLayoutItem ColSpan="5" RowSpan="2">
                                        <HeaderTemplate>
                                            <div class="k-d-flex k-align-items-center k-justify-content-between k-gap-2">
                                                <span>Time Taken By Action</span>
                                                <div @onclick:stopPropagation="true">
                                                    <TelerikButton Size="ComponentSize.Small"
                                                                   FillMode="ButtonFillMode.Flat"
                                                                   ThemeColor="ThemeConstants.Button.ThemeColor.Light"
                                                                   Icon="@SvgIcon.InfoCircle"
                                                                   Title="Show time taken by action info"
                                                                   OnClick="@(() => ToggleTileInfo(LogAnalysisTileInfo.TimeTakenByAction))" />
                                                </div>
                                            </div>
                                            @if (ActiveTileInfo == LogAnalysisTileInfo.TimeTakenByAction)
                                            {
                                                <div class="k-text-xs k-mt-1">@GetTileInfoText(LogAnalysisTileInfo.TimeTakenByAction)</div>
                                            }
                                        </HeaderTemplate>
                                        <Content>
                                            <TimeTakenByActionChart Results="@LogDataTimeTakenResults" />
                                        </Content>
                                    </TileLayoutItem>
                                </TileLayoutItems>
                            </TelerikTileLayout>
                        </div>
                    </Content>
                </DockManagerContentPane>
            </Panes>
        </DockManagerSplitPane>
    </DockManagerPanes>
</TelerikDockManager>
@*</div>*@
