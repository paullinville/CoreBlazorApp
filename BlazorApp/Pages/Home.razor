@page "/"
@using EATTS.Common.Models

<PageTitle>@PageTitleText</PageTitle>

<div class="dense-page home-report-page">
    <TelerikGrid @ref="ReportGrid" TItem="EntryOccurrenceSummaryModel" Class="dense-grid" OnRead="@ReadReportGridAsync" Height="100%" Size="ComponentSize.Small" Pageable="true" Sortable="false" Resizable="true">
        <GridSettings>
            <GridPagerSettings PageSizes="@(new List<int?> { 20, 35, 50 })" />
        </GridSettings>
        <GridToolBarTemplate>
            <div class="search-grid-toolbar">
                <TelerikButton Class="refresh-action" Size="ComponentSize.Small" FillMode="ButtonFillMode.Flat" OnClick="@RefreshGridAsync">
                    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M20 11a8 8 0 1 0-2.34 5.66" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <path d="M20 4v7h-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </TelerikButton>
            </div>
        </GridToolBarTemplate>
        <GridColumns>
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.EntryOccurrenceRef)" Title="Entry Occurrence Ref">
                <Template>
                    @{
                        var occurrence = (EntryOccurrenceSummaryModel)context;
                    }
                    <a class="entry-occurrence-link" href="#" @onclick:preventDefault="true" @onclick="@(() => OpenOccurrenceDetailsAsync(occurrence.EntryOccurrenceRef))">@occurrence.EntryOccurrenceRef</a>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.EntryRef)" Title="Entry Ref">
                <Template>
                    @{
                        var occurrence = (EntryOccurrenceSummaryModel)context;
                    }
                    <a class="entry-occurrence-link" href="#" @onclick:preventDefault="true" @onclick="@(() => OpenSupportOptionsWindowAsync(occurrence.EntryRef))">@occurrence.EntryRef</a>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.OccurrenceDescription)" Title="Description" />
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.CallerId)" Title="Caller Id" />
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.Subject)" Title="Subject" />
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.OccurrenceDate)" Title="Occurrence Date" DisplayFormat="{0:g}" />
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.Origin)" Title="Origin" />
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.Key)" Title="Key" />
        </GridColumns>
    </TelerikGrid>

    <SupportOptionsOverrideWindow EntryRef="@SelectedEntryRefForSupportOptions"
                                  IsVisible="@IsSupportOptionsWindowVisible"
                                  IsVisibleChanged="@OnSupportOptionsWindowVisibleChanged" />

    <OccurrenceDetailWindow OccurrenceDetail="@SelectedOccurrenceDetail" OccurrenceRefs="@OccurrenceRefsForWindow" OccurrenceRefChanged="@OpenOccurrenceDetailsAsync" IsVisible="@IsOccurrenceWindowVisible" IsVisibleChanged="@OnOccurrenceWindowVisibleChanged" />
</div>
