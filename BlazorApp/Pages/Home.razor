@page "/"
@using EATTS.Common.Models

<PageTitle>@PageTitleText</PageTitle>

<div class="dense-page home-report-page">
    <TelerikGrid @ref="ReportGrid" TItem="EntryOccurrenceSummaryModel" Class="dense-grid" OnRead="@ReadReportGridAsync" Height="100%" Size="ComponentSize.Small" Pageable="true" Sortable="false" Resizable="true">
        <GridSettings>
            <GridPagerSettings PageSizes="@(new List<int?> { 20, 35, 50 })" />
        </GridSettings>
        <GridToolBarTemplate>
            <div class="search-grid-toolbar">
                <TelerikButton Class="refresh-action" Size="ComponentSize.Small" FillMode="ButtonFillMode.Flat" OnClick="@RefreshGridAsync">
                    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M20 11a8 8 0 1 0-2.34 5.66" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <path d="M20 4v7h-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </TelerikButton>
            </div>
        </GridToolBarTemplate>
        <GridColumns>
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.EntryOccurrenceRef)" Title="Entry Occurrence Ref">
                <Template>
                    @{
                        var occurrence = (EntryOccurrenceSummaryModel)context;
                    }
                    <a class="entry-occurrence-link" href="#" @onclick:preventDefault="true" @onclick="@(() => OpenOccurrenceDetailsAsync(occurrence.EntryOccurrenceRef))">@occurrence.EntryOccurrenceRef</a>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.EntryRef)" Title="Entry Ref">
                <Template>
                    @{
                        var occurrence = (EntryOccurrenceSummaryModel)context;
                    }
                    <a class="entry-occurrence-link" href="#" @onclick:preventDefault="true" @onclick="@(() => OpenSupportOptionsWindowAsync(occurrence.EntryRef))">@occurrence.EntryRef</a>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.OccurrenceDescription)" Title="Description" />
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.CallerId)" Title="Caller Id" />
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.Subject)" Title="Subject" />
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.OccurrenceDate)" Title="Occurrence Date" DisplayFormat="{0:g}" />
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.Origin)" Title="Origin" />
            <GridColumn Field="@nameof(EntryOccurrenceSummaryModel.Key)" Title="Key" />
        </GridColumns>
    </TelerikGrid>

    <TelerikWindow Visible="@IsSupportOptionsWindowVisible"
                   VisibleChanged="@OnSupportOptionsWindowVisibleChanged"
                   Modal="true"
                   Width="700px"
                   Height="575px"
                   Resizable="true"
                   Draggable="true">
        <WindowTitle>
            Entry Ref @SelectedEntryRefForSupportOptions - Support Options
        </WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" />
        </WindowActions>
        <WindowContent>
            @if (IsSupportOptionsLoading)
            {
                <p>Loading support options...</p>
            }
            else
            {
                <EditForm Model="@SupportOptionsOverride" OnValidSubmit="@SaveSupportOptionsAsync">
                    <DataAnnotationsValidator />

                    <div class="k-form k-form-sm">
                        <div class="k-form-field k-mb-2">
                            <label for="home-support-flood-count">Flood Count</label>
                            <TelerikNumericTextBox Id="home-support-flood-count" @bind-Value="@SupportOptionsOverride.FloodCount" Min="1" Decimals="0" Format="n0" Arrows="true" Size="ComponentSize.Small" />
                            <ValidationMessage For="@(() => SupportOptionsOverride.FloodCount)" />
                        </div>

                        <div class="k-form-field k-mb-2">
                            <label for="home-support-flood-time">Flood Time (minutes)</label>
                            <TelerikNumericTextBox Id="home-support-flood-time" @bind-Value="@SupportOptionsOverride.FloodTime" Min="1" Decimals="0" Format="n0" Arrows="true" Size="ComponentSize.Small" />
                            <ValidationMessage For="@(() => SupportOptionsOverride.FloodTime)" />
                        </div>

                        <div class="k-form-field k-mb-2">
                            <label for="home-support-flood-email">Flood Email</label>
                            <UserMultiSelect Id="home-support-flood-email"
                                             @bind-Value="SelectedFloodEmailUserRefs"
                                             SelectedUsersChanged="@OnFloodEmailUsersChanged"
                                             Placeholder="Select users" />
                            <ValidationMessage For="@(() => SupportOptionsOverride.FloodEmail)" />
                        </div>

                        <div class="k-form-field k-mb-2">
                            <label for="home-support-other-email">Other Email</label>
                            <UserMultiSelect Id="home-support-other-email"
                                             @bind-Value="SelectedOtherEmailUserRefs"
                                             SelectedUsersChanged="@OnOtherEmailUsersChanged"
                                             Placeholder="Select users" />
                            <ValidationMessage For="@(() => SupportOptionsOverride.OtherEmail)" />
                        </div>

                        <div class="k-form-field k-mb-2">
                            <label for="home-support-reason">Reason</label>
                            <TelerikTextArea Size="ComponentSize.Small" Id="home-support-reason" @bind-Value="@SupportOptionsOverride.Reason" Rows="4" />
                            <ValidationMessage For="@(() => SupportOptionsOverride.Reason)" />
                        </div>

                        <div class="form-submit-actions">
                            <TelerikButton Class="cancel-action" Size="ComponentSize.Small" OnClick="@CancelSupportOptionsWindowAsync">Cancel</TelerikButton>
                            <TelerikButton Class="primary-action" Size="ComponentSize.Small" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" ButtonType="@ButtonType.Submit">Save</TelerikButton>
                        </div>
                    </div>
                </EditForm>
            }
        </WindowContent>
    </TelerikWindow>

    <OccurrenceDetailWindow OccurrenceDetail="@SelectedOccurrenceDetail" OccurrenceRefs="@OccurrenceRefsForWindow" OccurrenceRefChanged="@OpenOccurrenceDetailsAsync" IsVisible="@IsOccurrenceWindowVisible" IsVisibleChanged="@OnOccurrenceWindowVisibleChanged" />
</div>
