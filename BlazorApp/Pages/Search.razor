@page "/search"

<PageTitle>@PageTitleText</PageTitle>

<TelerikExpansionPanel Title="Search Criteria" Expanded="@IsSearchCriteriaExpanded" ExpandedChanged="@OnSearchCriteriaExpandedChanged" Width="100%">
    <Content>
        <div class="k-form k-form-sm search-grid-3">
            <div class="search-grid-column">
                <div>
                    <label for="entry-occurrence-origin">Origin</label>
                    <ApplicationSummaryComboBox Data="@ApplicationOptions"
                                                @bind-Value="CriteriaInput.Origin"
                                                Placeholder="Select origin"
                                                Width="100%"
                                                AdditionalAttributes="@(new Dictionary<string, object> { ["id"] = "entry-occurrence-origin" })" />
                </div>

                <div>
                    <label for="entry-occurrence-caller-id">Caller Id</label>
                    <TelerikTextBox Id="entry-occurrence-caller-id" Size="ComponentSize.Small" @bind-Value="CriteriaInput.CallerId" />
                </div>

                <div>
                    <label for="entry-occurrence-ref">Occurrence Ref</label>
                    <TelerikNumericTextBox Id="entry-occurrence-ref" Size="ComponentSize.Small" @bind-Value="CriteriaInput.OccurrenceRef" Decimals="0" Format="n0" />
                </div>
            </div>

            <div class="search-grid-column">
                <div>
                    <label for="entry-occurrence-user-ref">Reporting User</label>
                    <UserSelect Id="entry-occurrence-user-ref"
                                @bind-Value="CriteriaInput.OccurrenceUserRef"
                                Placeholder="Select user" />
                </div>

                <div>
                    <label for="entry-occurrence-emails-sent">Support Tech Contacted</label>
                    <UserSelect Id="entry-occurrence-emails-sent"
                                @bind-Value="EmailsSentUserRef"
                                SelectedUserChanged="@OnEmailsSentUserChanged"
                                Placeholder="Select user" />
                </div>
            </div>

            <div class="search-grid-column">
                <div>
                    <label for="entry-occurrence-date-start">Occurrence Date Start</label>
                    <TelerikDateTimePicker Id="entry-occurrence-date-start"
                                           @bind-Value="CriteriaInput.OccurrenceDateStart"
                                           Format="MM/dd/yyyy hh:mm"
                                           Size="ComponentSize.Small" />
                </div>

                <div>
                    <label for="entry-occurrence-date-end">Occurrence Date End</label>
                    <TelerikDateTimePicker Id="entry-occurrence-date-end"
                                           @bind-Value="CriteriaInput.OccurrenceDateEnd"
                                           Format="MM/dd/yyyy hh:mm"
                                           Size="ComponentSize.Small" />
                </div>
                <div>
                    <label for="entry-occurrence-is-error">Is Error</label>
                    <TriStateBooleanCheckBox Id="entry-occurrence-is-error"
                                             Value="@CriteriaInput.IsError"
                                             ValueChanged="@((bool? newValue) => CriteriaInput.IsError = newValue)" />
                </div>
            </div>

            <div class="search-grid-actions">
                <div class="form-submit-actions">
                    <TelerikButton Class="primary-action" Size="ComponentSize.Small" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" OnClick="@OnSearchClickedAsync">Search</TelerikButton>
                </div>
            </div>
        </div>
    </Content>
</TelerikExpansionPanel>

<TelerikExpansionPanel Title="Results" Expanded="@IsResultsExpanded" ExpandedChanged="@OnResultsExpandedChanged" AnimationDuration="0" Width="100%">
    <Content>
        @if (IsResultsLoading)
        {
            <div class="results-panel-loader">
                <TelerikLoader Visible="true" Size="LoaderSize.Medium" Type="LoaderType.InfiniteSpinner" />
                <span class="results-panel-loader-text">Loading results...</span>
            </div>
        }

        @if (ShowResultsGrid)
        {
            <TelerikGrid @ref="SearchResultsGrid" Class="dense-grid" Data="@GridData" Height="100%" Size="ComponentSize.Small" Pageable="true" Sortable="true" FilterMode="GridFilterMode.FilterRow" Resizable="true">
                <GridToolBarTemplate>
                    <div class="search-grid-toolbar">
                        <TelerikButton Size="ComponentSize.Small" Icon="@SvgIcon.FileExcel" OnClick="@ExportCurrentPageAsync">Export Page</TelerikButton>
                        <TelerikButton Size="ComponentSize.Small" Icon="@SvgIcon.FileExcel" OnClick="@ExportAllPagesAsync">Export All</TelerikButton>
                    </div>
                </GridToolBarTemplate>
                <GridSettings>
                    <GridPagerSettings PageSizes="@(new List<int?> { 20, 35, 50, 100 })" />
                </GridSettings>
                <GridExport>
                    <GridExcelExport FileName="SearchResults" AllPages="@ExportAllPages" />
                </GridExport>
                <NoDataTemplate>
                    No results found.
                </NoDataTemplate>
                <GridColumns>
                </GridColumns>
            </TelerikGrid>
        }
    </Content>
</TelerikExpansionPanel>

