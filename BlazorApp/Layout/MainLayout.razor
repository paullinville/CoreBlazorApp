@inherits LayoutComponentBase

<div class="main-layout k-d-flex k-flex-col" style="min-height:100vh">

    <TelerikAppBar Class="appbar">
        <AppBarSection Class="appbar-brand-section">
            <div class="appbar-brand k-d-flex k-flex-col k-align-items-start">
                <span role="button" tabindex="0" title="Reload application" @onclick="OnApplicationNameClicked" style="cursor:pointer; color:#dc6b12; font-size:2em; line-height:1;">
                    @ClientSettings.ApplicationName
                </span>
                <div class="appbar-nav-row">
                    @if (!string.IsNullOrEmpty(EnvironmentBannerText))
                    {
                        <span class="appbar-environment" style="font-size:1.1em; font-weight:600; color:@EnvironmentBannerColor;">
                            @EnvironmentBannerText
                        </span>
                    }
                    <TelerikMenu Data="@MenuItems"
                                 TextField="Text"
                                 UrlField="Url"
                                 IconField="Icon">
                        <ItemTemplate Context="item">
                            <span class="@GetMenuItemClass(item)" @onclick="CloseReportMenu">@item.Text</span>
                        </ItemTemplate>
                    </TelerikMenu>
                </div>
            </div>
        </AppBarSection>
        <AppBarSection Class="mock-notice-section">
            @if (ClientSettings.UseMocks)
            {
                <div class="mock-data-banner">You are using mock data!</div>
            }
        </AppBarSection>
        <AppBarSpacer />

        <AppBarSection Class="appbar-user-section">
            @if (!string.IsNullOrWhiteSpace(WelcomeText))
            {
                <div class="appbar-welcome">@WelcomeText</div>
            }

            <div class="appbar-actions-row">
                <a class="search-icon" href="/search" title="Search Grid" @onclick="CloseReportMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="6" />
                        <path d="M16 16 21 21" />
                    </svg>
                </a>
                <span @ref="ReportIconElement" id="report-icon" class="report-icon" role="button" tabindex="0" title="Reports" @onclick="ToggleReportMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 4.5v15h15" />
                        <path d="M7.5 15.5 11 11.5l3 2.2 4.5-6" />
                        <circle cx="7.5" cy="15.5" r="0.8" fill="currentColor" stroke="none" />
                        <circle cx="11" cy="11.5" r="0.8" fill="currentColor" stroke="none" />
                        <circle cx="14" cy="13.7" r="0.8" fill="currentColor" stroke="none" />
                        <circle cx="18.5" cy="7.7" r="0.8" fill="currentColor" stroke="none" />
                    </svg>
                </span>
                <span class="report-error-icon" role="button" tabindex="0" title="Report Error" @onclick="OnReportErrorClicked">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3.2 21.5 19.8a1 1 0 0 1-.87 1.5H3.37a1 1 0 0 1-.87-1.5L12 3.2Z" />
                        <line x1="12" y1="9.5" x2="12" y2="14" />
                        <circle cx="12" cy="17.3" r="1" fill="currentColor" stroke="none" />
                    </svg>
                </span>
                <span class="lock-key-icon" role="button" tabindex="0" title="Security" @onclick="OnLockKeyClicked">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="10" width="9" height="8" rx="1.2" />
                        <path d="M6.5 10V7.2a2.5 2.5 0 0 1 5 0V10" />
                        <circle cx="8.5" cy="14" r="1" />
                        <path d="M13 13.2h6.3" />
                        <path d="M17 13.2v2.4" />
                        <path d="M19.3 13.2v3.4" />
                    </svg>
                </span>

                <TelerikSwitch Class="theme-switch-section"
                               Value="@IsDarkTheme"
                               OnLabel="Dark"
                               OffLabel="Light"
                               Width="4.5rem"
                               ValueChanged="@(async (bool value) => await OnThemeChanged(value))" />
            </div>
        </AppBarSection>
    </TelerikAppBar>

    @if (IsReportMenuOpen)
    {
        <ul id="report-menu" class="report-menu" style="top:@(ReportMenuTop)px; left:@(ReportMenuLeft)px;">
            @foreach (var item in ReportMenuItems)
            {
                <li class="report-menu-item" @onclick="@(() => OnReportMenuItemClicked(item))">@item.Text</li>
            }
        </ul>
    }

    <main class="content @(ShowEnvironmentFrame ? "environment-content-frame" : string.Empty)" style="@(ShowEnvironmentFrame ? EnvironmentFrameStyle : null)">
        @Body
    </main>

</div>
