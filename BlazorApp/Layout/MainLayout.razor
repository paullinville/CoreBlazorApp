@inherits LayoutComponentBase

<div class="main-layout k-d-flex k-flex-col" style="min-height:100vh">

    <TelerikAppBar Class="appbar">
        <AppBarSection Class="appbar-brand-section">
            <div class="appbar-brand k-d-flex k-flex-col k-align-items-start">
                <span role="button" tabindex="0" title="Reload application" @onclick="OnApplicationNameClicked" style="cursor:pointer; color:var(--midland-orange); font-size:2em; line-height:1;">
                    @ClientSettings.ApplicationName
                </span>
                <div class="appbar-nav-row">
                    @if (!string.IsNullOrEmpty(EnvironmentBannerText))
                    {
                        <span class="appbar-environment" style="font-size:1.1em; font-weight:600; color:@EnvironmentBannerColor;">
                            @EnvironmentBannerText
                        </span>
                    }
                    <TelerikMenu Data="@MenuItems"
                                 TextField="Text"
                                 UrlField="Url"
                                 IconField="Icon">
                        <ItemTemplate Context="item">
                            <span class="@GetMenuItemClass(item)" @onclick="CloseReportMenu">@item.Text</span>
                        </ItemTemplate>
                    </TelerikMenu>
                </div>
            </div>
        </AppBarSection>
        <AppBarSection Class="mock-notice-section">
            @if (ClientSettings.UseMocks)
            {
                <div class="mock-data-banner">You are using mock data!</div>
            }
        </AppBarSection>
        <AppBarSpacer />

        <AppBarSection Class="appbar-user-section">
            @if (!string.IsNullOrWhiteSpace(WelcomeText))
            {
                <button type="button" class="appbar-welcome appbar-welcome-button" @onclick="OnWelcomeClicked">@WelcomeText</button>
            }

            <div class="appbar-actions-row" @onkeydown="OnGoToInputKeyDown">
                <div class="goto-occurrence-group" @onpaste="OnGoToOccurrenceTextBoxPasteAsync">
                    <TelerikNumericTextBox Class="goto-occurrence-input"
                                           @bind-Value="GoToOccurrenceRef"
                                           Min="1"
                                           Decimals="0"
                                           Format="D"
                                           Arrows="false"
                                           Placeholder="Occurrence #"
                                            />
                    <button type="button" class="goto-icon appbar-goto-icon" title="GoTo" aria-label="GoTo" @onclick="OnGoToClickedAsync">
                    <?xml version="1.0" encoding="UTF-8" standalone="no" ?>
                    <svg viewBox="0 0 24 24"
                         width="18"
                         height="18"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         version="1.1"
                         id="svg2"
                         sodipodi:docname="goto.svg"
                         inkscape:version="1.4.4 (dcaf3e7, 2026-05-05)"
                         xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape"
                         xmlns:sodipodi="http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd"
                         xmlns="http://www.w3.org/2000/svg"
                         xmlns:svg="http://www.w3.org/2000/svg">
                        <defs id="defs2" />
                        <sodipodi:namedview id="namedview2"
                                            pagecolor="#ffffff"
                                            bordercolor="#000000"
                                            borderopacity="0.25"
                                            inkscape:showpageshadow="2"
                                            inkscape:pageopacity="0.0"
                                            inkscape:pagecheckerboard="0"
                                            inkscape:deskcolor="#d1d1d1"
                                            showgrid="false"
                                            inkscape:zoom="45.833333"
                                            inkscape:cx="8.9890909"
                                            inkscape:cy="9"
                                            inkscape:window-width="1920"
                                            inkscape:window-height="1027"
                                            inkscape:window-x="-8"
                                            inkscape:window-y="-3"
                                            inkscape:window-maximized="1"
                                            inkscape:current-layer="svg2" />
                        <!-- Curve rising upward from left to right -->
                        <path d="m 4.9999639,18.999964 c 8.0000001,-2 12.0000001,-8 12.0000001,-16.0000001"
                              id="path1" />
                        <!-- Arrowhead pointing right -->
                        <path d="m 20.999964,6.9999639 -4,-6.00000002 -4,6.00000002"
                              id="path2" />
                    </svg>
                </button>
                </div>
                <a class="search-icon" href="/search" title="Search Grid" @onclick="CloseReportMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="6" />
                        <path d="M16 16 21 21" />
                    </svg>
                </a>
                <span @ref="ReportIconElement" id="report-icon" class="report-icon" role="button" tabindex="0" title="Reports" @onclick="ToggleReportMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 4.5v15h15" />
                        <path d="M7.5 15.5 11 11.5l3 2.2 4.5-6" />
                        <circle cx="7.5" cy="15.5" r="0.8" fill="currentColor" stroke="none" />
                        <circle cx="11" cy="11.5" r="0.8" fill="currentColor" stroke="none" />
                        <circle cx="14" cy="13.7" r="0.8" fill="currentColor" stroke="none" />
                        <circle cx="18.5" cy="7.7" r="0.8" fill="currentColor" stroke="none" />
                    </svg>
                </span>

                <span @ref="SettingsIconElement" id="settings-icon" class="settings-icon" role="button" tabindex="0" title="Settings" @onclick="ToggleSettingsMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="6" x2="20" y2="6" />
                        <circle cx="9" cy="6" r="1.8" fill="currentColor" stroke="none" />
                        <line x1="4" y1="12" x2="20" y2="12" />
                        <circle cx="15" cy="12" r="1.8" fill="currentColor" stroke="none" />
                        <line x1="4" y1="18" x2="20" y2="18" />
                        <circle cx="11" cy="18" r="1.8" fill="currentColor" stroke="none" />
                    </svg>
                </span>
                <TelerikSwitch Class="theme-switch-section"
                               Value="@IsDarkTheme"
                               OnLabel="Dark"
                               OffLabel="Light"
                               Width="4.5rem"
                               ValueChanged="@(async (bool value) => await OnThemeChanged(value))" />
                <span class="report-error-icon" role="button" tabindex="0" title="Report Error" @onclick="OnReportErrorClicked">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3.2 21.5 19.8a1 1 0 0 1-.87 1.5H3.37a1 1 0 0 1-.87-1.5L12 3.2Z" />
                        <line x1="12" y1="9.5" x2="12" y2="14" />
                        <circle cx="12" cy="17.3" r="1" fill="currentColor" stroke="none" />
                    </svg>
                </span>
                <span class="lock-key-icon" role="button" tabindex="0" title="Security" @onclick="OnLockKeyClicked">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="10" width="9" height="8" rx="1.2" />
                        <path d="M6.5 10V7.2a2.5 2.5 0 0 1 5 0V10" />
                        <circle cx="8.5" cy="14" r="1" />
                        <path d="M13 13.2h6.3" />
                        <path d="M17 13.2v2.4" />
                        <path d="M19.3 13.2v3.4" />
                    </svg>
                </span>
            </div>
        </AppBarSection>
    </TelerikAppBar>

    @if (IsReportMenuOpen)
    {
        <ul id="report-menu" class="report-menu" style="top:@(ReportMenuTop)px; left:@(ReportMenuLeft)px;">
            @foreach (var item in ReportMenuItems.Values())
            {
                <li class="report-menu-item" @onclick="@(() => OnReportMenuItemClicked(item))">@item.Text</li>
            }
        </ul>
    }

    @if (IsSettingsMenuOpen)
    {
        <ul id="settings-menu" class="report-menu" style="top:@(SettingsMenuTop)px; left:@(SettingsMenuLeft)px;">
            @foreach (var item in SettingsMenuItems.Values())
            {
                <li class="report-menu-item" @onclick="@(() => OnSettingsMenuItemClicked(item))">@item.Text</li>
            }
        </ul>
    }

    <TokenTreeWindow Visible="@IsWelcomeWindowVisible"
                      VisibleChanged="@OnWelcomeWindowVisibleChanged"
                      TreeItems="@DecodedTokenTreeItems"
                      PermissionItems="@DecodedTokenPermissions"
                      CopyClicked="@OnCopyTokenClicked"
                      CloseClicked="@OnCloseWelcomeWindowClicked" />

    <OccurrenceDetailWindow OccurrenceDetail="@SelectedOccurrenceDetail" OccurrenceRefs="@OccurrenceRefsForWindow" OccurrenceRefChanged="@OpenOccurrenceDetailsAsync" IsVisible="@IsOccurrenceWindowVisible" IsVisibleChanged="@OnOccurrenceWindowVisibleChanged" />

    <main class="content @(ShowEnvironmentFrame ? "environment-content-frame" : string.Empty)" style="@(ShowEnvironmentFrame ? EnvironmentFrameStyle : null)">
        <GlobalErrorBoundaryBase>
            <ApiNotification />
            <ApiMessageNotification />
            @Body
         </GlobalErrorBoundaryBase>
    </main>

</div>