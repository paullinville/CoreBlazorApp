@inherits LayoutComponentBase

<div class="main-layout k-d-flex k-flex-col" style="min-height:100vh">

    <!-- Global Navigation (optional) -->
    <header class="k-p-3 k-shadow">
        <TelerikMenu Data="@MenuItems"
                     TextField="Text"
                     UrlField="Url"
                     IconField="Icon" />
    </header>

    <!-- Routed Page Content -->
    <main class="k-flex-grow k-p-4">
        @Body
    </main>

</div>

@code {
    public List<MenuItem> MenuItems = new()
    {
        new MenuItem { Text = "Home", Url = "/" },
        new MenuItem { Text = "Products", Url = "/products" },
        new MenuItem { Text = "Settings", Url = "/settings" }
    };

    public class MenuItem
    {
        public string Text { get; set; }
        public string Url { get; set; }
        public string Icon { get; set; }
    }
}
