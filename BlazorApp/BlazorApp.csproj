<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="RestEase" Version="1.6.4" />
    <!--<PackageReference Include="RestEase.SystemTextJson" Version="1.5.4" />-->
    <PackageReference Include="Telerik.UI.for.Blazor">
      <Version>15.0.0</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Midland.Core.SimpleMessageBus\Midland.Core.SimpleMessageBus.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)'=='Release'">
    <Compile Remove="Mocks\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\*.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ProjectExtensions>
    <VisualStudio>
      <UserProperties UseCdnSupport="False" UseFontIcons="False" />
    </VisualStudio>
  </ProjectExtensions>
</Project>