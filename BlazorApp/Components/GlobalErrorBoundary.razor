@inherits GlobalErrorBoundaryBase

@if (CurrentException != null)
{
    <div class="error-ui">
        <h3>Something went wrong</h3>
        <p>The application hit an unexpected error.</p>

        <button class="btn btn-primary" @onclick="Recover">
            Try Again
        </button>
    </div>
}
else
{
    @ChildContent
}
