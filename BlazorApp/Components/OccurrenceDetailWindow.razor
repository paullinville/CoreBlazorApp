@using EATTS.Common.Models

@if (OccurrenceDetail is not null)
{
    <TelerikWindow Visible="@IsVisible"
                   VisibleChanged="@OnVisibleChangedAsync"
                   Modal="true"
                   Width="1400px"
                   Height="850px"
                   Resizable="true"
                   Draggable="true">
        <WindowTitle>
            <span style="display:inline-flex; align-items:center; gap:0.5rem;">
                <span>Occurrence Details</span>
                <button id="previous-button" type="button" class="goto-icon" title="Previous" aria-label="Previous" disabled="@(!CanGoToPrevious)" @onclick="OnPreviousClickedAsync">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5" />
                        <path d="m11 7-6 5 6 5" />
                    </svg>
                </button>
                <button id="next-button" type="button" class="goto-icon" title="Next" aria-label="Next" disabled="@(!CanGoToNext)" @onclick="OnNextClickedAsync">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14" />
                        <path d="m13 7 6 5-6 5" />
                    </svg>
                </button>
            </span>
            <TelerikTooltip TargetSelector="#previous-button" Position="TooltipPosition.Top">
                <Template>
                    <div>Previous occurrence.</div>
                </Template>
            </TelerikTooltip>
            <TelerikTooltip TargetSelector="#next-button" Position="TooltipPosition.Top">
                <Template>
                    <div>Next occurrence.</div>
                </Template>
            </TelerikTooltip>
        </WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" />
        </WindowActions>
        <WindowContent>
            <TelerikDockManager Width="100%" Height="100%">
                <DockManagerPanes>
                    <DockManagerSplitPane Orientation="DockManagerPaneOrientation.Vertical">
                        <Panes>
                            <DockManagerSplitPane Orientation="DockManagerPaneOrientation.Horizontal" Size="50%">
                                <Panes>
                                    <DockManagerContentPane Id="occurrence-details-pane" HeaderText="Details" Size="30%" AllowFloat="false" Unpinnable="false" Closeable="false">
                                        <Content>
                                            <div class="occurrence-tile-section">
                                                <div class="k-grid k-grid-md dense-grid occurrence-details-table">
                                                    <table class="k-grid-table">
                                                        <colgroup>
                                                            <col style="width: 100px;" />
                                                            <col />
                                                        </colgroup>
                                                        <thead class="k-table-thead">
                                                            <tr class="k-table-row">
                                                                <th class="k-table-th">Field</th>
                                                                <th class="k-table-th">Value</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody class="k-table-tbody">
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Occurrenc#</td>
                                                                <td class="k-table-td">
                                                                    <a style="text-decoration:underline;" href="@($"/occurrence-details/{OccurrenceDetail.EntryOccurrenceRef}")">@OccurrenceDetail.EntryOccurrenceRef</a>
                                                                </td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Entry#</td>
                                                                <td class="k-table-td">@OccurrenceDetail.EntryRef</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Date</td>
                                                                <td class="k-table-td">@OccurrenceDetail.Date</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Description</td>
                                                                <td class="k-table-td">@OccurrenceDetail.Description</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Generic</td>
                                                                <td class="k-table-td">@OccurrenceDetail.GenericDescription</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Key</td>
                                                                <td class="k-table-td">@OccurrenceDetail.Key</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Origin</td>
                                                                <td class="k-table-td">@OccurrenceDetail.Origin</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Caller Id</td>
                                                                <td class="k-table-td">@OccurrenceDetail.CallerId</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Emails</td>
                                                                <td class="k-table-td">@OccurrenceDetail.EmailsSent</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Error</td>
                                                                <td class="k-table-td">@OccurrenceDetail.Error</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Token Subject</td>
                                                                <td class="k-table-td">@OccurrenceDetail.TokenSubject</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Token Type</td>
                                                                <td class="k-table-td">@OccurrenceDetail.TokenType</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Api Slug</td>
                                                                <td class="k-table-td">@OccurrenceDetail.ApiSlug</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Count</td>
                                                                <td class="k-table-td">@OccurrenceDetail.OccurrenceCount</td>
                                                            </tr>
                                                            <tr class="k-table-row">
                                                                <td class="k-table-td">Last</td>
                                                                <td class="k-table-td">@OccurrenceDetail.LastEntryOccurrenceRef</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </Content>
                                    </DockManagerContentPane>

                                    <DockManagerContentPane Id="occurrence-logs-pane" HeaderText="Logs" Size="70%" AllowFloat="false" Unpinnable="false" Closeable="false">
                                        <Content>
                                            <div class="occurrence-tile-section">
                                                <TelerikGrid TItem="ApiLogDataModel" Data="@LogEntries" Size="ComponentSize.Small" Pageable="false" Sortable="true" Resizable="true" Height="100%">
                                                    <GridColumns>
                                                        <GridColumn Field="@nameof(ApiLogDataModel.ApiLogRef)" Title="ApiLogRef" />
                                                        <GridColumn Field="@nameof(ApiLogDataModel.ApiName)" Title="ApiName" />
                                                        <GridColumn Field="@nameof(ApiLogDataModel.LogDate)" Title="LogDate" DisplayFormat="{0:g}" />
                                                        <GridColumn Field="@nameof(ApiLogDataModel.Server)" Title="Server" />
                                                        <GridColumn Field="@nameof(ApiLogDataModel.Error)" Title="Error" />
                                                        <GridColumn Field="@nameof(ApiLogDataModel.RequestId)" Title="RequestId" />
                                                    </GridColumns>
                                                </TelerikGrid>
                                            </div>
                                        </Content>
                                    </DockManagerContentPane>
                                </Panes>
                            </DockManagerSplitPane>

                            <DockManagerContentPane Id="occurrence-stacktrace-pane" HeaderText="Stack Trace" Size="50%" AllowFloat="false" Unpinnable="false" Closeable="false">
                                <Content>
                                    @if (StackTraceText.IsNotNullOrBlank())
                                    {
                                        <pre class="occurrence-stack-trace-block">@StackTraceText</pre>
                                    }
                                    else
                                    {
                                        <div class="occurrence-tile-section">No stack trace available.</div>
                                    }
                                </Content>
                            </DockManagerContentPane>
                        </Panes>
                    </DockManagerSplitPane>
                </DockManagerPanes>
            </TelerikDockManager>
        </WindowContent>
    </TelerikWindow>
}
