@using BlazorApp.Models

<TelerikGrid Data="@Results" Height="250px">
    <GridColumns>
        <GridColumn Field="Action" Title="Action" />
        <GridColumn Field="Slope" Title="Slope (ms/window)" DisplayFormat="{0:N0}" />
        <GridColumn Field="Intercept" Title="Baseline (ms)" DisplayFormat="{0:N0}" />
    </GridColumns>
</TelerikGrid>

@code {
    [Parameter] public List<TrendSlopeResult> Results { get; set; } = new();
}
