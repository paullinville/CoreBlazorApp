@using EATTS.Common.Models

<h3>EntryDetail</h3>

<div>@ErrorResponse.Code</div>
<div>@ErrorResponse.Title</div>
<div>@ErrorResponse.RequestId.ToString()</div>
<div>@ErrorResponse.RequestPath</div>
<div>@ErrorResponse.Description</div>
<ul>
@foreach(var line in ErrorResponse.Details.StackTrace)
{
    <li>@line</li>
}
</ul>