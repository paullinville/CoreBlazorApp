@using Midland.Core.Common;
<TelerikNotification @ref="@ValidationNotification"
                     Class="validation-notification"
                     HorizontalPosition="@NotificationHorizontalPosition.Center"
                     VerticalPosition="@NotificationVerticalPosition.Top">
    <Template Context="item">
        <div class="notification-row">
            <div class="k-d-inline-flex k-align-items-center" style="gap:2px;">
                <span class="notification-text">@GetDisplayText(item.Text)</span>
            </div>
        </div>
    </Template>
</TelerikNotification>

<TelerikNotification @ref="@GeneralNotification"
                     Class="error-notification"
                     HorizontalPosition="@NotificationHorizontalPosition.Center"
                     VerticalPosition="@NotificationVerticalPosition.Top">
    <Template Context="item">
        <div class="notification-row">
            <div class="k-d-inline-flex k-align-items-center" style="gap:2px;">
                <span class="notification-text">@GetDisplayText(item.Text)</span>
            </div>
            @if (CanReport(item))
            {
                <a href="#"
                   @onclick="@(() => ReportCurrentError(item))"
                   @onclick:preventDefault="true"
                   class="k-link report-link">
                    Report
                </a>
            }
        </div>
    </Template>
</TelerikNotification>
